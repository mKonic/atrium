+
+bool link_output_program(struct output_shader *shader);
+
 struct box_shadow_shader {
 	GLuint program;
 	GLint proj;
diff --git a/include/scenefx/render/fx_renderer/fx_offscreen_buffers.h b/include/scenefx/render/fx_renderer/fx_offscreen_buffers.h
index c3e2e02..f2502a0 100644
--- a/include/scenefx/render/fx_renderer/fx_offscreen_buffers.h
+++ b/include/scenefx/render/fx_renderer/fx_offscreen_buffers.h
@@ -24,6 +24,9 @@ struct fx_offscreen_buffers {
 	struct fx_framebuffer *effects_buffer;
 	// Swap buffer used for effects
 	struct fx_framebuffer *effects_buffer_swapped;
+	// HDR (or any output color transform): the frame is drawn here in
