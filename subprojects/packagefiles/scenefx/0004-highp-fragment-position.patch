+
 float get_dist(vec2 q, float radius) {
 	return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius;
 }
@@ -13,7 +22,7 @@ float corner_alpha(vec2 size, vec2 position, bool is_cutout,
 		return 1.0;
 	}
 
-	vec2 relative_pos = (gl_FragCoord.xy - position);
