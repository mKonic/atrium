diff --git a/render/fx_renderer/shaders/box_shadow.frag b/render/fx_renderer/shaders/box_shadow.frag
index 1cab7b5..d0a7921 100644
--- a/render/fx_renderer/shaders/box_shadow.frag
+++ b/render/fx_renderer/shaders/box_shadow.frag
@@ -1,12 +1,20 @@
 // Writeup: https://madebyevan.com/shaders/fast-rounded-rectangle-shadows/
 
-#ifdef GL_FRAGMENT_PRECISION_HIGH
+// highp: NVIDIA's GLES doesn't define GL_FRAGMENT_PRECISION_HIGH, and its
+// mediump is real fp16: texture coordinates and positions past 1024 pixels
+// snap to whole or half pixels (see v_frag).
 precision highp float;
-#else
-precision mediump float;
-#endif
 
 varying vec4 v_color;
+#ifndef ATRIUM_V_FRAG
+#define ATRIUM_V_FRAG
+// Where this fragment is, in framebuffer pixels: gl_FragCoord, but highp
+// (GLSL ES 1.00's is mediump, which NVIDIA honours: past 1024 pixels it
+// rounds pixel centres in pairs, so every curve there was drawn at half
+// resolution).
+varying vec2 v_frag;
+#endif
+
 varying vec2 v_texcoord;
 
 uniform vec2 position;
@@ -73,7 +81,7 @@ void main() {
     float shadow_alpha = v_color.a * roundedBoxShadow(
             position + blur_sigma,
             position + size - blur_sigma,
-            gl_FragCoord.xy, blur_sigma * 0.5,
+            v_frag, blur_sigma * 0.5,
             corner_radius);
 
     // Clipping
diff --git a/render/fx_renderer/shaders/common.vert b/render/fx_renderer/shaders/common.vert
index 9e7b073..d322220 100644
--- a/render/fx_renderer/shaders/common.vert
+++ b/render/fx_renderer/shaders/common.vert
@@ -4,10 +4,14 @@ uniform mat3 tex_proj;
 attribute vec2 pos;
 varying vec4 v_color;
 varying vec2 v_texcoord;
+// The framebuffer's size, and where a fragment is in it (see v_frag).
+uniform vec2 frag_size;
+varying vec2 v_frag;
 
 void main() {
 	vec3 pos3 = vec3(pos, 1.0);
 	gl_Position = vec4(pos3 * proj, 1.0);
 	v_color = color;
 	v_texcoord = (pos3 * tex_proj).xy;
+	v_frag = (gl_Position.xy * 0.5 + 0.5) * frag_size;
 }
