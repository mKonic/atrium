@@ -681,6 +692,12 @@ void wlr_scene_blur_set_alpha(struct wlr_scene_blur *blur, float alpha);
  */
 void wlr_scene_blur_set_refraction(struct wlr_scene_blur *blur, float refraction, float thickness);
 
