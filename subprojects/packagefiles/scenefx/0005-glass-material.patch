 	set_tex_matrix(shader->tex_proj, WL_OUTPUT_TRANSFORM_NORMAL, &src_fbox);
@@ -1344,8 +1463,10 @@ static void render_glass(struct fx_gles_render_pass *pass, struct fx_texture *bl
 	if (mask_tex) {
