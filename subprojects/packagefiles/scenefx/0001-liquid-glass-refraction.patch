 include/render/fx_renderer/shaders.h     | 20 +++++++
 include/scenefx/render/pass.h            |  4 ++
 include/scenefx/types/wlr_scene.h        |  9 +++
 render/fx_renderer/fx_pass.c             | 72 +++++++++++++++++++++++-
