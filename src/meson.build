  'xdg_view.cpp',
  'xwayland_focus.cpp',
  'xwayland_view.cpp',
)

executable('atrium',
  atrium_sources, protocol_headers, protocol_code, version_h, paths_h,
  dependencies: deps,
  install_rpath: get_option('prefix') / get_option('libdir') / 'atrium',  # its wlroots
  install: true,
)

executable('atriumctl',
  '../tools/atriumctl.cpp', 'records.cpp',
  dependencies: [json],
  install: true,
)

# A health check of atrium and its session, and fixing what's installed
# when what atrium was built against moved (tools/doctor): nothing but the
# C++ runtime, so it runs when that has moved under atrium.
executable('atrium-doctor', '../tools/doctor/main.cpp', '../tools/doctor/doctor_core.cpp',
  '../tools/doctor/checks.cpp', '../tools/doctor/probe.cpp', '../shell/plugin/Atrium/updates_core.cpp',
  include_directories: include_directories('../shell/plugin/Atrium'),
  dependencies: [json],
  install: true,
)

# atrium's own grim (tools/screenshot).
executable('atrium-screenshot', '../tools/screenshot/main.cpp', '../tools/screenshot/shot_core.cpp', capture_client_protocols,
  include_directories: include_directories('../protocols'),
  dependencies: [dependency('wayland-client'), pixman, dependency('libpng'), dependency('libjpeg')],
  install: true,
)

# atrium's own gpu-screen-recorder (tools/record).
executable('atrium-record', '../tools/record/main.cpp', '../tools/record/record_core.cpp', '../tools/record/capture.cpp',
  '../tools/record/gpu.cpp', '../tools/record/encoder.cpp', '../tools/record/vulkan.cpp', '../tools/record/audio.cpp',
  '../tools/record/screen_color.cpp', capture_client_protocols, version_h,
  include_directories: include_directories('../protocols'),
  dependencies: [dependency('wayland-client'), dependency('libavcodec'), dependency('libavformat'), dependency('libavutil'),
    dependency('libswresample'), dependency('libpipewire-0.3'), dependency('gbm'), dependency('egl'), dependency('glesv2'),
    dependency('libdrm'), dependency('vulkan').partial_dependency(compile_args: true, includes: true), json],
  install: true,
)
