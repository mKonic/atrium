atrium_sources = files(
  'anim.cpp',
  'cairo_buffer.cpp',
  'config.cpp',
  'geometry.cpp',
  'input_method.cpp',
  'ipc.cpp',
  'background_effect.cpp',
  'layer_surface.cpp',
  'main.cpp',
  'overview.cpp',
  'registry.cpp',
  'displays.cpp',
  'output.cpp',
  'seat.cpp',
  'server.cpp',
  'rules.cpp',
  'sandbox.cpp',
  'session_lock.cpp',
  'shell_process.cpp',
  'snap_preview.cpp',
  'space.cpp',
  'switcher.cpp',
  'tiling.cpp',
  'window_hints.cpp',
  'spaces.cpp',
  'settings.cpp',
  'theme.cpp',
  'titlebar.cpp',
  'view.cpp',
  'window_copy.cpp',
  'xdg_view.cpp',
  'xwayland_view.cpp',
)

executable('atrium',
  atrium_sources, protocol_headers, protocol_code, version_h, paths_h,
  dependencies: deps,
  install: true,
)

executable('atriumctl',
  '../tools/atriumctl.cpp',
  dependencies: [json],
  install: true,
)
