  'popup_blur.cpp',
  'icc_core.cpp',
  'hot_corners_core.cpp',
  'panel_edge_core.cpp',
  'button_remap.cpp',
  'eis_core.cpp',
  'eis.cpp',
  'gamepads.cpp',
  'touch_tablet.cpp',
  'not_responding.cpp',
  'system_bell.cpp',
  'snapshot.cpp',
  'clipboard_history.cpp',
  'cairo_buffer.cpp',
  'config.cpp',
  'geometry.cpp',
  'input_method.cpp',
  'text_input_v1.cpp',
  'pointer_warp.cpp',
  'commit_pacing.cpp',
  'xwayland_grab.cpp',
  'x11_listen.cpp',
  'x11_listen_core.cpp',
  'launch_feedback.cpp',
  'ipc.cpp',
  'background_effect.cpp',
  'glass.cpp',
  'toplevel_drag.cpp',
  'session_management.cpp',
  'toplevel_icon.cpp',
  'appmenu.cpp',
  'layer_surface.cpp',
  'main.cpp',
  'overview.cpp',
  'registry.cpp',
  'records.cpp',
  'keyword_watch.cpp',
  'displays.cpp',
  'edid.cpp',
  'output.cpp',
  'handoff.cpp',
  'i18n.cpp',
  'display_share.cpp',
  'scene_dump.cpp',
  'access_keys_core.cpp',
  'night_light.cpp',
  'night_light_core.cpp',
  'seat.cpp',
  'shake.cpp',
  'keyboard_conf.cpp',
  'server.cpp',
  'rules.cpp',
  'sandbox.cpp',
  'session_lock.cpp',
  'shell_process.cpp',
  'snap_preview.cpp',
