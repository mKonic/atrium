# atrium from this checkout: `makepkg -si` in this directory (or from a copy
# of this file with ATRIUM_SRC set to the checkout, so the build leaves the
# tree untouched). The version is scripts/version.sh's, set by pkgver():
# 1.0.0 at the tag v1.0.0, 1.0.0.r12.gabc1234 past it, 1.4.0rc.1 for
# v1.4.0-rc.1, 0.rN.hash before any tag.
pkgname=atrium-git
pkgver=0
pkgrel=1
pkgdesc='A floating-first Wayland desktop'
arch=('x86_64')
# Symbols kept: crash dumps and profiles of a running desktop name functions.
options=('!strip' '!debug')
url='https://github.com/mKonic/atrium'
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=(
  # compositor
  wayland libinput systemd-libs libxkbcommon pixman cairo pango libdrm glib2 sqlite libdisplay-info
  xcb-util-wm libxcrypt fontconfig xorg-xwayland
  # its wlroots (built in, under /usr/lib/atrium)
  seatd libliftoff lcms2 libglvnd mesa libxcb xcb-util-errors xcb-util-renderutil
  # shell
  qt6-base qt6-declarative qt6-wayland layer-shell-qt polkit-qt6 libpulse
  # phone link: its audio stream, the pairing crypto and finding the phone
  libpipewire openssl avahi
  # what the shell fronts
  pipewire-pulse wireplumber polkit networkmanager bluez bluez-libs power-profiles-daemon udisks2
  xdg-desktop-portal xdg-desktop-portal-wlr
  cliphist wl-clipboard grim
  # the shell's icons and monospace font (Rubik comes with it)
  ttf-material-symbols-variable ttf-cascadia-code-nerd
  # apps looking at home
  adw-gtk-theme breeze-icons
)
makedepends=(git meson ninja wayland-protocols gtest cmake hwdata)
optdepends=(
  'cups: printing'
  "greetd: atrium's login screen (see /usr/share/atrium/greetd-config.toml)"
  'uwsm: the uwsm-managed session'
  'gpu-screen-recorder: screen recording'
  'ddcutil: brightness of external monitors'
  'fcitx5: input methods'
  'noto-fonts-cjk: Chinese, Japanese and Korean text (and input method candidates)'
  'xdg-terminal-exec: terminal apps started in your terminal'
  'packagekit: software updates in Settings'
  'qtengine: Qt apps in atrium'"'"'s colours with your own Qt style'
  # The apps around it: atrium recommends these rather than shipping its own.
  'ghostty: a terminal (or foot, kitty, konsole: the first installed is used)'
  'dolphin: a file manager (the Dock'"'"'s first app)'
  'kate: a text editor'
)
provides=(atrium)
conflicts=(atrium)
source=("atrium::git+file://${ATRIUM_SRC:-${startdir}/../..}")
sha256sums=('SKIP')

pkgver() {
  cd atrium
  local name
  name=$(scripts/version.sh name)
  case "$name" in
    # Past a tag: .rN.gHASH. A pre-release joins the version (1.4.0rc.1),
    # which pacman sorts before 1.4.0; any other hyphen becomes a dot.
    v[0-9]*) echo "${name#v}" | sed -E 's/-([0-9]+)-g([0-9a-f]+)$/.r\1.g\2/; s/-//; s/-/./g' ;;
    *) printf '0.r%s.%s' "$(git rev-list --count HEAD)" "$name" ;;
  esac
}

prepare() {
  cd atrium
  # atrium's wlroots and scenefx (submodules) and nlohmann-json, fetched
  # here, not while building.
  git submodule update --init
  meson subprojects download nlohmann_json
}

build() {
  arch-meson atrium build --wrap-mode=nodownload -Dtests=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  # scenefx is linked in and wlroots goes to /usr/lib/atrium (an install
  # script); their headers and pkg-config files stay out.
  meson install -C build --destdir "$pkgdir" --skip-subprojects
}
